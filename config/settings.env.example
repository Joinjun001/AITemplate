# 이 파일을 config/settings.env 로 복사해서 필요한 값만 덮어쓰세요.
# (config/settings.env 는 .gitignore에 포함되어 있어서 커밋되지 않습니다.)

# 재시도 상한 - 이 횟수를 넘기면 작업이 "blocked" 상태로 멈추고 사람 확인을 기다립니다.
# MAX_RETRIES=3

# 리밋 메시지를 감지했지만 정확한 리셋 시각을 못 읽어냈을 때 기본으로 잠들 시간(분)
# Claude Code 는 롤링 5시간 한도이므로 기본값은 300분(5시간)입니다.
# DEFAULT_COOLDOWN_MIN_CLAUDE=300

# Gemini CLI 는 보통 자정(현지시간) 기준 일일 한도라 기본값을 짧게 잡았습니다.
# 필요하면 조정하세요.
# DEFAULT_COOLDOWN_MIN_GEMINI=60
